{
  "name": "tauridium",
  "version": "1.0.12",
  "description": "Tauridium - lightweight Tauri client for Ferdium",
  "author": "Daniel Braniewski",
  "homepage": "https://github.com/Akkitto/Tauridium",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akkitto/Tauridium.git"
  },
  "bugs": {
    "url": "https://github.com/Akkitto/Tauridium/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node tools/check_deepmerge.mjs && node tools/check_picomatch.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "deepmerge": "file:vendor/deepmerge",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "picomatch": "file:vendor/picomatch"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "picomatch": "$picomatch"
  }
}
