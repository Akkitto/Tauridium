# GitHub Linguist classification.
#
# Tauridium deliberately presents the repository language bar as Rust-only.
# The application still contains its real Svelte/TypeScript/JavaScript frontend
# and support sources; those files remain unchanged and keep their normal syntax
# highlighting. This override affects GitHub repository language statistics only.
# See: https://github.com/github-linguist/linguist/blob/main/docs/overrides.md

# Count only Rust in GitHub's repository language statistics. Do not relabel any
# non-Rust source as Rust; simply make non-Rust files non-detectable for stats.
* linguist-detectable=false
*.rs linguist-detectable=true

# Third-party sources vendored to make Tauridium's patched Tauri/Wry build
# reproducible remain explicitly classified by provenance.
vendor/** linguist-vendored
src-tauri/assets/darkreader.js linguist-vendored
flatpak/shared-modules/** linguist-vendored

# Preserve upstream patch context exactly while keeping whitespace checks strict
# for Tauridium-authored patches and source files.
flatpak/shared-modules/**/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Generated metadata and schemas remain explicitly marked as generated.
src-tauri/gen/** linguist-generated
.tauridium-source-manifest.json linguist-generated
vite-env.d.ts linguist-generated

# Documentation remains classified separately as documentation.
docs/** linguist-documentation
