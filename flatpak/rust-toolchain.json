{
  "name": "rust-toolchain",
  "buildsystem": "simple",
  "build-commands": [
    "cd rustc && ./install.sh --prefix=/app/lib/tauridium-rust-toolchain --disable-ldconfig",
    "cd cargo && ./install.sh --prefix=/app/lib/tauridium-rust-toolchain --disable-ldconfig",
    "cd rust-std && ./install.sh --prefix=/app/lib/tauridium-rust-toolchain --disable-ldconfig",
    "install -Dm644 check-rust-toolchain.py /app/lib/tauridium-rust-toolchain/check-rust-toolchain.py",
    "python3 /app/lib/tauridium-rust-toolchain/check-rust-toolchain.py"
  ],
  "cleanup": [
    "*"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://static.rust-lang.org/dist/2026-07-16/rustc-1.97.1-x86_64-unknown-linux-gnu.tar.xz",
      "sha256": "9819d0a32d56bd339585319c80260e332779f5541fd66838ab7e016d6c814819",
      "only-arches": [
        "x86_64"
      ],
      "dest": "rustc"
    },
    {
      "type": "archive",
      "url": "https://static.rust-lang.org/dist/2026-07-16/rustc-1.97.1-aarch64-unknown-linux-gnu.tar.xz",
      "sha256": "b344b81f0cd4c2246c7da8b197fe7a339d7dd02bb15cb69b2524115d9c75224c",
      "only-arches": [
        "aarch64"
      ],
      "dest": "rustc"
    },
    {
      "type": "archive",
      "url": "https://static.rust-lang.org/dist/2026-07-16/cargo-1.97.1-x86_64-unknown-linux-gnu.tar.xz",
      "sha256": "e1be5f5ff7f7f80ca506fb65770b759edbdc6d303781ed71c5de8ec8a8394779",
